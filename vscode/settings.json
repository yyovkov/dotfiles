{
    "workbench.startupEditor": "none",
    "workbench.colorCustomizations": {
        "peekView.border": "#50A69B",
        "peekViewTitle.background": "#002b36",
        "peekViewResult.background": "#00212b",
        "peekViewEditor.background": "#002b36",
        "peekViewEditor.matchHighlightBackground": "#00212bAB",
    },
    "python.terminal.activateEnvironment": false,
    "extensions.ignoreRecommendations": true,
    "editor.wordWrap": "on",
    "editor.rulers": [80, 120],
    "editor.cursorStyle": "block",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.delivery": true,
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.sqlite3": true,
        "**/.svn": true,
        "**/.terraform": true,
        "**/.venv": true,
        "**/.vscode": true,
        "**/Berksfile.lock": true,
        "**/chefignore": true,
        "**/CVS": true
    },
    "editor.minimap.enabled": false,
    "editor.glyphMargin": false,
    // Per Filetype Tab Size
    "[html]": {
        "editor.tabSize": 2
    },
    "[vue-html]": {
        "editor.tabSize": 2
    },
    "[ruby]": {
        "editor.tabSize": 2
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.formatOnType": true
    },
    "[json]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[terraform]": {
        "editor.tabSize": 2
    },
    "[makefile]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[django-html]": {
        "editor.tabSize": 4
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[vue]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2
    },
    "[hcl]": {
        "editor.tabSize": 2
    },
    "[shellscript]": {
        "editor.tabSize": 4
    },
    "git.autofetch": true,
    "editor.fontSize": 16,
    "files.associations": {
        "*.mkt": "rosScript",
        "*.ks": "properties",
        "*.html": "html",
        "*.tmpl": "html"
    },
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontFamily": "SauceCodePro Nerd Font Mono",
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.defaultProfile.osx": "bash (2)",
    "terminal.integrated.profiles.osx": {
        "bash": {
            "path": "bash",
            "args": [
                "-l"
            ],
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "/usr/loca/bin/bash",
            "args": [
                "-l"
            ]
        },
        "fish": {
            "path": "fish",
            "args": [
                "-l"
            ]
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        },
        "bash (2)": {
            "path": "/opt/homebrew/bin/bash"
        }
    },
    "go.formatTool": "goimports",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-c>": false,
        "<C-v>": false
    },
    "material-icon-theme.folders.color": "#42a5f5",
    "material-icon-theme.folders.theme": "classic",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "editor.suggestSelection": "first",
    "python.languageServer": "Pylance",
    "go.toolsManagement.autoUpdate": true,
    "vsicons.dontShowNewVersionMessage": true,
    "[go]": {

        "editor.tabSize": 2,
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "never"
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.defaultFormatter": "golang.go"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "redhat.telemetry.enabled": false,
    "files.insertFinalNewline": true,
    "settingsSync.ignoredExtensions": [
        "shan.code-settings-sync"
    ],
    "go.enableCodeLens": {
        "runtest": false
    },
    "go.editorContextMenuCommands": {},
    "window.autoDetectColorScheme": true,
    "python.defaultInterpreterPath": "python3",
    "editor.acceptSuggestionOnEnter": "off",
    "python.venvPath": "${workspaceFolder}/.venv",
    "editor.largeFileOptimizations": false,
    "git.openRepositoryInParentFolders": "always",
    "workbench.iconTheme": "material-icon-theme",
    "editor.autoClosingQuotes": "never",
    "editor.accessibilitySupport": "off",
    "vim.cursorStylePerMode.insert": "line",
    "vim.cursorStylePerMode.replace": "block-outline",
    "vim.startInInsertMode": false,
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    "workbench.editor.empty.hint": "hidden",
    "editor.defaultFormatter": "redhat.ansible",
    "js/ts.preferences.quoteStyle": "single",
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.CustomBrowser": "chrome",
    "liveServer.settings.donotVerifyTags": true,
    "editor.stickyScroll.enabled": false,
    "editor.stickyScroll.scrollWithEditor": false,
    "workbench.activityBar.location": "hidden",
    "settingsSync.ignoredSettings": [
        "-python.venvPath"
    ],
    "terminal.integrated.hideOnStartup": "always",
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "material-icon-theme.rootFolders.color": "#90a4ae",
    "material-icon-theme.activeIconPack": "angular",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.fontFamily": "Source Code Pro for Powerline",
    "chat.viewSessions.orientation": "stacked",
    "ansible.lightspeed.enabled": false,
    "ansible.lightspeed.suggestions.enabled": false,
    "editor.defaultFoldingRangeProvider": "redhat.ansible",
    "notebook.defaultFormatter": "redhat.ansible",
    "[ansible]": {
        "editor.defaultFormatter": null
    },
    "workbench.colorTheme": "Visual Studio Light",
    "workbench.preferredDarkColorTheme": "Visual Studio Dark - C++",
}
